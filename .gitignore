__pycache__/
*.pyc
.env
*.egg-info/
venv/
.venv/
.pytest_cache/

# Retraining backup snapshots and runtime/log state (local safety net and
# transient status, not shared history - grows every retrain)
model_artifacts_backups/
retrain_last_run.log
retrain_status.json
*.log

# Stale training-script chart output (regenerated by scfi_model_v3.py runs;
# not the source of truth - that's model_artifacts/ itself)
SCFI_model_results.png
SCFI_shap_lstm.png

# Firebase service account keys should never be committed - keep them
# out of version control. (model_artifacts/*.pkl and .keras ARE tracked
# deliberately, so a fresh clone runs with real models out of the box -
# see the root .gitignore's comment and the project's own documentation
# for this tradeoff.)
serviceAccountKey.json
*serviceAccount*.json
