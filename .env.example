# Copy this file to .env and fill in real values when ready.
# The app runs fine with NONE of these set — Firestore falls back to
# in-memory storage and CORS defaults to localhost dev ports.

# Comma-separated list of frontend origins allowed to call this API.
# Add your Firebase Hosting URL here once you deploy, e.g.:
# ALLOWED_ORIGINS=http://localhost:5173,https://your-project.web.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Path to a Firebase service account JSON key (Project Settings >
# Service Accounts > Generate New Private Key in the Firebase console).
# Leave blank to use in-memory storage instead of Firestore.
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=

# Where trained model artifacts (.pkl/.h5/etc.) live on disk.
MODEL_ARTIFACTS_DIR=./model_artifacts

# FRED API credentials
FRED_API_KEY=

# Supabase storage credentials
SUPABASE_URL=
SUPABASE_KEY=

DEFAULT_HORIZON_WEEKS=8
SCFI_MIN=800.0
SCFI_MAX=5000.0
